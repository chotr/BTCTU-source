{
  "name": "btctu",
  "version": "0.4.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "pnpm --parallel --filter @btctu/api --filter @btctu/web dev",
    "dev:web": "pnpm --filter @btctu/web dev",
    "dev:api": "pnpm --filter @btctu/api dev",
    "deploy:api": "pnpm --filter @btctu/api run deploy",
    "preview:api": "pnpm --filter @btctu/api run preview",
    "deploy:web": "pnpm --filter @btctu/web run deploy:cf",
    "preview:web": "pnpm --filter @btctu/web run preview:cf",
    "db:local": "docker compose up -d db",
    "db:clone": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clone-db.ps1",
    "setup:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-local.ps1",
    "package:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-local.ps1",
    "setup:local:restore": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-local.ps1 -RestoreDump",
    "package:local:with-db": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-local.ps1 -IncludeDatabase",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm --filter @btctu/web build",
    "test": "pnpm -r test",
    "test:api": "pnpm --filter @btctu/api test",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  }
}
